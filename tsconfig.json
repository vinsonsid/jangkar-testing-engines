{
  "extends": "./configs/tsconfig/strict.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["examples/**/*.ts", "examples/**/*.mjs", "configs/**/*.mjs", "bin/**/*.mjs", "tests/**/*.mjs", "*.mjs"],
  "exclude": ["node_modules", "templates", "**/coverage", "**/.stryker-tmp"]
}
